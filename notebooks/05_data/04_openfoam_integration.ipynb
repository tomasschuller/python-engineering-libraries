    "## 5. Automating CFD Workflows\n",
    "\n",
    "This section shows how to automate CFD simulations with Python."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5.1 Parameter sweep\n",
    "print(\"=== Parameter Sweep ===\")\n",
    "\n",
    "import numpy as np\n",
    "import subprocess\n",
    "import os\n",
    "import shutil\n",
    "\n",
    "# Define parameter ranges\n",
    "velocities = [0.5, 1.0, 1.5, 2.0]  # m/s\n",
    "results = []\n",
    "\n",
    "for i, vel in enumerate(velocities):\n",
    "    print(f\"\\nRunning case {i+1}/{len(velocities)} with velocity = {vel} m/s\")\n",
    "    \n",
    "    # Create a new case directory\n",
    "    case_name = f\"cavity_vel_{vel}\"\n",
    "    case_path = os.path.join(os.getcwd(), case_name)\n",
    "    \n",
    "    # Copy the base case\n",
    "    if os.path.exists(case_path):\n",
    "        shutil.rmtree(case_path)\n",
    "    shutil.copytree(\"simpleCavity\", case_path)\n",
    "    \n",
    "    # Modify the U boundary condition\n",
    "    U_file = os.path.join(case_path, \"0\", \"U\")\n",
    "    with open(U_file, \"r\") as f:\n",
    "        content = f.read()\n",
    "    \n",
    "    # Replace the velocity value\n",
    "    content = content.replace(\"uniform (1 0 0)\", f\"uniform ({vel} 0 0)\")\n",
    "    \n",
    "    with open(U_file, \"w\") as f:\n",
    "        f.write(content)\n",
    "    \n",
    "    # Run the simulation\n",
    "    try:\n",
    "        result = subprocess.run(\n",
    "            [\"simpleFoam\"],\n",
    "            cwd=case_path,\n",
    "            capture_output=True,\n",
    "            text=True,\n",
    "            timeout=300\n",
    "        )\n",
    "        \n",
    "        if result.returncode == 0:\n",
    "            print(f\"  Case completed successfully.\")\n",
    "            # Read results and store\n",
    "            results.append({\n",
    "                \"velocity\": vel,\n",
    "                \"case_path\": case_path,\n",
    "                \"status\": \"success\"\n",
    "            })\n",
    "        else:\n",
    "            print(f\"  Case failed: {result.stderr}\")\n",
    "            results.append({\n",
    "                \"velocity\": vel,\n",
    "                \"case_path\": case_path,\n",
    "                \"status\": \"failed\"\n",
    "            })\n",
    "    except Exception as e:\n",
    "        print(f\"  Error: {e}\")\n",
    "        results.append({\n",
    "            \"velocity\": vel,\n",
    "            \"case_path\": case_path,\n",
    "            \"status\": f\"error: {e}\"\n",
    "        })\n",
    "\n",
    "print(f\"\\nCompleted {len(results)} cases.\")"
   ]
