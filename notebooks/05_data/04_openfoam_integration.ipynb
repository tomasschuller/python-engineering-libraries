   "source": [
    "## 4. Post-Processing Results\n",
    "\n",
    "This section shows how to read and process OpenFOAM results from Python."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4.1 Read OpenFOAM results\n",
    "print(\"=== Reading OpenFOAM Results ===\")\n",
    "\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "# Function to read OpenFOAM field data\n",
    "def read_openfoam_field(case_path, time_dir, field_name):\n",
    "    \"\"\"Read an OpenFOAM field file\"\"\"\n",
    "    field_file = os.path.join(case_path, time_dir, field_name)\n",
    "    \n",
    "    if not os.path.exists(field_file):\n",
    "        print(f\"Field file not found: {field_file}\")\n",
    "        return None\n",
    "    \n",
    "    with open(field_file, \"r\") as f:\n",
    "        content = f.read()\n",
    "    \n",
    "    # Parse the internalField\n",
    "    start = content.find(\"internalField\")\n",
    "    if start == -1:\n",
    "        print(\"Could not find internalField\")\n",
    "        return None\n",
    "    \n",
    "    # Find the start of the data\n",
    "    start = content.find(\"(\", start)\n",
    "    end = content.find(\")\", start)\n",
    "    \n",
    "    if start == -1 or end == -1:\n",
    "        print(\"Could not parse field data\")\n",
    "        return None\n",
    "    \n",
    "    data_str = content[start+1:end]\n",
    "    \n",
    "    # Parse the data\n",
    "    data = []\n",
    "    for line in data_str.strip().split(\"\\n\"):\n",
    "        line = line.strip()\n",
    "        if line and not line.startswith(\"//\"):\n",
    "            values = line.split()\n",
    "            for v in values:\n",
    "                try:\n",
    "                    data.append(float(v))\n",
    "                except ValueError:\n",
    "                    pass\n",
    "    \n",
    "    return np.array(data)\n",
    "\n",
    "# Try to read the pressure field\n",
    "time_dir = \"1000\"  # Adjust to the latest time directory\n",
    "p_data = read_openfoam_field(case_path, time_dir, \"p\")\n",
    "\n",
    "if p_data is not None:\n",
    "    print(f\"Read pressure field with {len(p_data)} values\")\n",
    "    print(f\"Min: {p_data.min():.4f}, Max: {p_data.max():.4f}, Mean: {p_data.mean():.4f}\")\n",
    "else:\n",
    "    print(\"Could not read pressure field.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4.2 Compute statistics\n",
    "print(\"\\n=== Computing Statistics ===\")\n",
    "\n",
    "if p_data is not None:\n",
    "    # Compute statistics\n",
    "    p_mean = np.mean(p_data)\n",
    "    p_std = np.std(p_data)\n",
    "    p_min = np.min(p_data)\n",
    "    p_max = np.max(p_data)\n",
    "    \n",
    "    print(f\"Pressure statistics:\")\n",
    "    print(f\"  Mean: {p_mean:.4f}\")\n",
    "    print(f\"  Std: {p_std:.4f}\")\n",
    "    print(f\"  Min: {p_min:.4f}\")\n",
    "    print(f\"  Max: {p_max:.4f}\")\n",
    "    \n",
    "    # Plot histogram\n",
    "    import matplotlib.pyplot as plt\n",
    "    \n",
    "    plt.figure(figsize=(10, 6))\n",
    "    plt.hist(p_data, bins=30, edgecolor='black', alpha=0.7)\n",
    "    plt.axvline(x=p_mean, color='r', linestyle='--', label=f'Mean: {p_mean:.3f}')\n",
    "    plt.xlabel('Pressure (Pa)')\n",
    "    plt.ylabel('Count')\n",
    "    plt.title('Pressure Distribution')\n",
    "    plt.legend()\n",
    "    plt.grid(True, alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
