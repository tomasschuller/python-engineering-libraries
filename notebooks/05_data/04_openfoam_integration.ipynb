   "source": [
    "## 2. Creating an OpenFOAM Case\n",
    "\n",
    "This section shows how to create a simple OpenFOAM case from Python."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2.1 Create a simple case directory structure\n",
    "print(\"=== Creating OpenFOAM Case ===\")\n",
    "\n",
    "import os\n",
    "import shutil\n",
    "\n",
    "# Define case parameters\n",
    "case_name = \"simpleCavity\"\n",
    "case_path = os.path.join(os.getcwd(), case_name)\n",
    "\n",
    "# Create directory structure\n",
    "dirs = [\n",
    "    case_path,\n",
    "    os.path.join(case_path, \"system\"),\n",
    "    os.path.join(case_path, \"constant\"),\n",
    "    os.path.join(case_path, \"0\"),\n",
    "    os.path.join(case_path, \"constant\", \"polyMesh\")\n",
    "]\n",
    "\n",
    "for d in dirs:\n",
    "    os.makedirs(d, exist_ok=True)\n",
    "\n",
    "print(f\"Created case directory: {case_path}\")\n",
    "print(f\"Directory structure:\")\n",
    "for d in dirs:\n",
    "    print(f\"  {os.path.relpath(d, case_path)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2.2 Write the controlDict file\n",
    "print(\"\\n=== Writing controlDict ===\")\n",
    "\n",
    "controlDict = \"\"\"\n",
    "// Cavity flow case\n",
    "FoamFile\n",
    "{\n",
    "    version     2.0;\n",
    "    format      ascii;\n",
    "    class       dictionary;\n",
    "    object      controlDict;\n",
    "}\n",
    "\n",
    "// Application\n",
    "application     simpleFoam;\n",
    "\n",
    "// Start from\n",
    "startFrom       latestTime;\n",
    "\n",
    "// Time specification\n",
    "startTime       0;\n",
    "stopTime        1000;\n",
    "deltaT          1;\n",
    "\n",
    "// Write controls\n",
    "writeControl    timeStep;\n",
    "writeInterval   100;\n",
    "\n",
    "// RunTimeModifiable\n",
    "runTimeModifiable true;\n",
    "\"\"\"\n",
    "\n",
    "with open(os.path.join(case_path, \"system\", \"controlDict\"), \"w\") as f:\n",
    "    f.write(controlDict)\n",
    "\n",
    "print(\"Written: system/controlDict\")"
   ]
  },
