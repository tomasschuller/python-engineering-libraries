   "source": [
    "# 6.1 Simple optimization loop\n",
    "print(\"=== Optimization Loop ===\")\n",
    "\n",
    "import numpy as np\n",
    "from scipy.optimize import minimize\n",
    "\n",
    "# Define the objective function\n",
    "def objective(params):\n",
    "    \"\"\"\n",
    "    Objective function for optimization.\n",
    "    params: [velocity, angle]\n",
    "    \"\"\"\n",
    "    velocity, angle = params\n",
    "    \n",
    "    # Run OpenFOAM simulation (simplified)\n",
    "    # In a real application, this would run the full simulation\n",
    "    # and extract the drag coefficient\n",
    "    \n",
    "    # For demonstration, use a simple model\n",
    "    cd = 0.02 + 0.01 * velocity**2 + 0.005 * angle**2\n",
    "    \n",
    "    return cd\n",
    "\n",
    "# Define constraints\n",
    "constraints = [\n",
    "    {'type': 'ineq', 'fun': lambda x: x[0] - 0.5},  # velocity >= 0.5\n",
    "    {'type': 'ineq', 'fun': lambda x: 2.0 - x[0]},  # velocity <= 2.0\n",
    "    {'type': 'ineq', 'fun': lambda x: x[1]},  # angle >= 0\n",
    "    {'type': 'ineq', 'fun': lambda x: 20 - x[1]}  # angle <= 20\n",
    "]\n",
    "\n",
    "# Initial guess\n",
    "x0 = [1.0, 10.0]\n",
    "\n",
    "# Run optimization\n",
    "result = minimize(objective, x0, method='SLSQP', constraints=constraints)\n",
    "\n",
    "print(f\"Optimization result:\")\n",
    "print(f\"  Velocity: {result.x[0]:.3f} m/s\")\n",
    "print(f\"  Angle: {result.x[1]:.3f} deg\")\n",
    "print(f\"  Minimum Cd: {result.fun:.4f}\")"
   ]
